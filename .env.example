# Copy to .env.local and set your own secret locally. Do not commit that file.
# Requires Node.js 22.9+ (Node.js 24 recommended).
DEEPSEEK_API_KEY=
# Local production server only. Development keeps the original 5173 port.
PORT=5173
# Never use VITE_DEEPSEEK_API_KEY: VITE_ variables are embedded in browser assets.
